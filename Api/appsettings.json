{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "MPDCApiTemplate",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=REPLACE_DEFAULT_DB_INSTANCE;Database=MPDCApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True",
    "Logging": "Server=REPLACE_LOGGING_DB_INSTANCE;Database=MPDCApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "MPDCApiTemplate",
    "Audience": "MPDCApiTemplate",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
    "EmailRequestedTopic": "primary-topic-notification",
    "DeadLetterTopic": "dlq-topic-notification",
    "ConsumerGroup": "notification-service-email-v1",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "Acks": "All"
  },
  "Outbox": { "BatchSize": 100, "PollingIntervalSeconds": 2, "ProcessedRetentionDays": 7 },
  "EmailDelivery": { "BatchSize": 50, "MaximumConcurrency": 10, "MaximumAttempts": 5, "PollingIntervalSeconds": 2 },
  "EmailProvider": {
    "Provider": "Fake", "BaseUrl": "https://api.brevo.com/v3/", "ApiKey": "",
    "DefaultSenderEmail": "no-reply@example.invalid", "DefaultSenderName": "Notification Service",
    "AllowedSenderEmails": [ "no-reply@example.invalid" ], "AllowedTemplateIds": [ "payment-confirmed" ],
    "AllowSubjectOverride": false, "TimeoutSeconds": 15
  },
  "EmailTemplates": { "RootPath": "Templates" },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console", "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
