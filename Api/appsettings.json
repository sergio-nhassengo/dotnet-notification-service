{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "MPDCApiTemplate",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=REPLACE_DEFAULT_DB_INSTANCE;Database=MPDCApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True",
    "Logging": "Server=REPLACE_LOGGING_DB_INSTANCE;Database=MPDCApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "MPDCApiTemplate",
    "Audience": "MPDCApiTemplate",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
    "EmailRequestedTopic": "primary-topic-notification",
    "DeadLetterTopic": "dlq-topic-notification",
    "ConsumerGroup": "notification-service-email-v1",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "Acks": "All",
    "Enabled": true
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "ProcessedRetentionDays": 7
  },
  "EmailDelivery": {
    "MaximumAttempts": 5,
    "PollingIntervalSeconds": 5
  },
  "EmailProvider": {
    "Provider": "Fake",
    "BaseUrl": "https://api.brevo.com/v3/",
    "ApiKey": "",
    "DefaultSenderEmail": "no-reply@example.invalid",
    "DefaultSenderName": "Notification Service",
    "AllowedSenderEmails": [
      "no-reply@example.invalid"
    ],
    "AllowedTemplateIds": [
      "payment-confirmed"
    ],
    "AllowSubjectOverride": false,
    "TimeoutSeconds": 15
  },
  "EmailTemplates": {
    "RootPath": "Templates"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "NotificationIntegration": {
    "AllowLegacyJwtClients": true,
    "Applications": {
      "otc-api": {
        "Enabled": true,
        "ApiKeySha256": "",
        "SenderEmail": "no-reply@example.invalid",
        "SenderName": "OTC Notifications",
        "ReplyTo": null,
        "AllowedTemplateIds": [
          "otc-additional-cargo-requested",
          "otc-additional-cargo-approved",
          "otc-additional-cargo-rejected",
          "otc-work-order-approval-requested",
          "otc-vessel-arrival-updated",
          "otc-vessel-grt-not-billable",
          "otc-bank-guarantees-expiring",
          "vessel-bulletin-report",
          "weighbridge-ticket",
          "weighbridge-transactions-report",
          "data-integrity-report"
        ],
        "AllowRawContent": true,
        "AllowSubjectOverride": true,
        "MaximumRecipients": 50,
        "MaximumAttachments": 5,
        "MaximumAttachmentBytes": 5242880
      },
      "weighbridge-api": {
        "Enabled": true,
        "ApiKeySha256": "",
        "SenderEmail": "no-reply@example.invalid",
        "SenderName": "Weighbridge Notifications",
        "ReplyTo": null,
        "AllowedTemplateIds": [
          "vessel-bulletin-report",
          "weighbridge-truck-on-hold",
          "weighbridge-truck-release-approved",
          "weighbridge-truck-release-rejected",
          "weighbridge-shipping-activated",
          "weighbridge-shipping-deactivated",
          "rail-consignment-alert",
          "weighbridge-wagon-confirmed",
          "weighbridge-wagon-declined",
          "weighbridge-equipment-approval-requested",
          "weighbridge-ticket",
          "weighbridge-transactions-report",
          "data-integrity-report"
        ],
        "AllowRawContent": true,
        "AllowSubjectOverride": true,
        "MaximumRecipients": 50,
        "MaximumAttachments": 5,
        "MaximumAttachmentBytes": 5242880
      },
      "tan-webservice": {
        "Enabled": true,
        "ApiKeySha256": "",
        "SenderEmail": "no-reply@example.invalid",
        "SenderName": "TAN Notifications",
        "ReplyTo": null,
        "AllowedTemplateIds": [
          "rail-consignment-alert",
          "tan-tip-generated",
          "tan-tip-payment-submitted",
          "tan-tip-payment-confirmed",
          "tan-tip-payment-failed",
          "tan-truck-release-requested",
          "tan-cbr-vessel-change-requested",
          "tan-sew-integration-failed",
          "weighbridge-ticket",
          "weighbridge-transactions-report",
          "data-integrity-report",
          "tan-trips-history-report"
        ],
        "AllowRawContent": true,
        "AllowSubjectOverride": true,
        "MaximumRecipients": 50,
        "MaximumAttachments": 5,
        "MaximumAttachmentBytes": 5242880
      }
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "EnableSsl": true,
    "UseDefaultCredentials": false,
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  }
}
