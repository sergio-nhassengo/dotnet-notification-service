{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "ApiTemplate",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,14330;Database=ApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True",
    "Logging": "Server=localhost,14330;Database=ApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ApiTemplate",
    "Audience": "ApiTemplate",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console", "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
