{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=REPLACE_DEFAULT_DB_INSTANCE;Database=MPDCApiTemplate;User Id=sa;Password=P@ssw0rd_Verify1;TrustServerCertificate=True",
    "Logging": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
    "EmailRequestedTopic": "primary-topic-notification",
    "DeadLetterTopic": "dlq-topic-notification",
    "ConsumerGroup": "notification-service-email-v1",
    "SecurityProtocol": "Plaintext",
    "Enabled": true
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "ProcessedRetentionDays": 7
  },
  "EmailDelivery": {
    "MaximumAttempts": 5,
    "PollingIntervalSeconds": 5
  },
  "EmailProvider": {
    "Provider": "SmtpRelay"
  },
  "EmailTemplates": {
    "RootPath": "Templates"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "NotificationIntegration": {
    "Applications": {
      "tan-webservice": {
        "Enabled": true,
        "ApiKeySha256": "",
        "SenderEmail": "no-reply@example.invalid",
        "SenderName": "TAN Notifications",
        "AllowedTemplateIds": [
          "data-integrity-report",
          "payment-confirmed",
          "rail-consignment-alert",
          "tan-account-created",
          "tan-account-reset",
          "tan-agent-account-notification",
          "tan-agent-allocation",
          "tan-border-arrival-driver-conflict",
          "tan-cbr-status-notification",
          "tan-cbr-vessel-change-requested",
          "tan-data-integrity-report-link",
          "tan-driver-details",
          "tan-duplicate-declarations",
          "tan-duplicate-payment-references",
          "tan-import-result",
          "tan-message",
          "tan-operational-failure",
          "tan-receipt-completed",
          "tan-receipt-nett-deviation",
          "tan-receipt-time-discrepancy",
          "tan-sew-integration-failed",
          "tan-sew-response-errors",
          "tan-sew-trucks-uploaded",
          "tan-tip-batch-generated",
          "tan-tip-generated",
          "tan-tip-payment-confirmed",
          "tan-tip-payment-failed",
          "tan-tip-payment-submitted",
          "tan-trips-history-report",
          "tan-truck-details-missing",
          "tan-truck-release-operations-review",
          "tan-truck-release-requested",
          "tan-wagons-deleted",
          "tan-wagons-submitted",
          "tan-wagons-updated",
          "weighbridge-ticket",
          "weighbridge-transactions-report"
        ],
        "AllowRawContent": true,
        "AllowSubjectOverride": true,
        "MaximumRecipients": 50
      }
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "EnableSsl": true,
    "UseDefaultCredentials": false,
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  }
}
