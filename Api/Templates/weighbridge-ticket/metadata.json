{
  "id": "weighbridge-ticket",
  "applications": [
    "tan-webservice"
  ],
  "title": "Weighbridge ticket",
  "minimumAttachments": 1,
  "source": "weighbridge-tan-webservice/Infrastructure/Services/ReceiptTransactionNotification.cs",
  "variables": {
    "ticketId": {
      "description": "Ticket",
      "example": "TKT-104"
    },
    "ticketType": {
      "description": "Ticket type",
      "example": "Road receipt"
    },
    "registrationNumber": {
      "description": "Truck",
      "example": "AAA-123-MP"
    },
    "orderNumber": {
      "description": "Order",
      "example": "ORD-204"
    },
    "customerName": {
      "description": "Customer",
      "example": "Example Cargo"
    },
    "issuedAt": {
      "description": "Issued at",
      "example": "09 Sep 2026 10:00 CAT"
    }
  }
}
