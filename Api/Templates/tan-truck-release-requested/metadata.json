{
  "id": "tan-truck-release-requested",
  "applications": [
    "tan-webservice"
  ],
  "title": "Truck release awaiting Operations review",
  "minimumAttachments": 0,
  "source": "weighbridge-tan-webservice/Application/Transactions/ReleaseTruckTransaction.cs",
  "variables": {
    "registrationNumber": {
      "description": "Truck",
      "example": "AAA-123-MP"
    },
    "tanId": {
      "description": "TAN",
      "example": "TAN-1204"
    },
    "orderNumber": {
      "description": "Order",
      "example": "ORD-204"
    },
    "trailer1": {
      "description": "Trailer 1",
      "example": "TRL-101"
    },
    "trailer2": {
      "description": "Trailer 2",
      "example": "Not applicable"
    },
    "customerName": {
      "description": "Customer",
      "example": "Example Cargo"
    },
    "commodity": {
      "description": "Commodity",
      "example": "Coal"
    },
    "destination": {
      "description": "Destination / slab",
      "example": "Terminal 1"
    },
    "mineTicketNumber": {
      "description": "Mine ticket",
      "example": "MT-204"
    },
    "mineGrossMass": {
      "description": "Mine gross mass (kg)",
      "example": "48,000"
    },
    "grossMass": {
      "description": "First mass (kg)",
      "example": "47,800"
    },
    "reason": {
      "description": "Original hold reason",
      "example": "Weight discrepancy requires review."
    },
    "agentComment": {
      "description": "Agent comment",
      "example": "Supporting documents have been provided."
    },
    "releasedAt": {
      "description": "Agent release submitted at",
      "example": "09 Sep 2026 11:00 CAT"
    }
  }
}
