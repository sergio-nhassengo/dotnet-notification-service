    "trailer1": {
      "description": "Trailer 1",
      "example": "TRL-101"
    },
    "trailer2": {
      "description": "Trailer 2",
      "example": "Not applicable"
    },
    "mineTicketNumber": {
      "description": "Mine ticket",
      "example": "MT-204"
    },
    "customerName": {
      "description": "Cargo owner",
      "example": "Example Cargo"
    },
    "declarationNumber": {
      "description": "Declaration",
      "example": "DEC-104"
    },
    "paymentReference": {
      "description": "Payment reference",
      "example": "PAY-104"
