{
  "id": "otc-vessel-arrival-updated",
  "applications": [
    "otc-api"
  ],
  "title": "Vessel arrival / berthing updated",
  "minimumAttachments": 0,
  "source": "otc-api/Application/VesselBerthings/UpdateArrivalAndBerthingDates.cs",
  "variables": {
    "vesselName": {
      "description": "Vessel",
      "example": "MV Example"
    },
    "workOrderId": {
      "description": "Work order",
      "example": "WO-1204"
    },
    "marineVoyageNumber": {
      "description": "Marine voyage / Contra-Marca",
      "example": "MV-204"
    },
    "arrivalAt": {
      "description": "Arrival",
      "example": "09 Sep 2026 10:00 CAT"
    },
    "berthingAt": {
      "description": "Berthing",
      "example": "09 Sep 2026 12:00 CAT"
    },
    "berth": {
      "description": "Berth",
      "example": "Berth 1"
    }
  }
}
