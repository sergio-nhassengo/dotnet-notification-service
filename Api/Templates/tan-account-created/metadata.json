{
  "id": "tan-account-created",
  "applications": [
    "tan-webservice"
  ],
  "title": "Account created",
  "source": "weighbridge-tan-webservice/Infrastructure/Services/UserService.cs",
  "variables": {
    "fullName": {
      "description": "Account holder",
      "example": "Example User"
    },
    "username": {
      "description": "Username",
      "example": "example.user"
    },
    "password": {
      "description": "Initial or reset password (sensitive)",
      "example": "EXAMPLE-ONLY-ChangeMe"
    },
    "loginUrl": {
      "description": "Cargo Booking address",
      "example": "https://tan.portmaputo.com"
    }
  }
}
