# Copy this file to `.env` (git-ignored) and fill in real values.

ASPNETCORE_ENVIRONMENT=Development


DB_CONNECTION_STRING=Server=host.docker.internal;Database=MPDCApiTemplate;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
LOGGING_DB_CONNECTION_STRING=Server=host.docker.internal;Database=MPDCApiTemplate;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True

# Must be a long random string in any real environment.
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
